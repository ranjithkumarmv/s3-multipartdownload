    "bench": "node bench/benchmark.js"
  },
  "keywords": [
    "s3",
    "aws",
    "aws-s3",
    "amazon-s3",
    "aws-sdk",
    "aws-sdk-v3",
    "client-s3",
    "s3-download",
    "parallel-download",
    "multipart-download",
    "multipart",
    "range-request",
    "byte-range",
    "getobject",
    "concurrent",
    "download-manager",
    "transfer-manager",
    "large-files",
    "stream",
    "fast",
    "minio",
    "cloudflare-r2",
    "nodejs",
    "typescript"
  ],
  "homepage": "https://github.com/ranjithkumarmv/s3-multipartdownload#readme",
