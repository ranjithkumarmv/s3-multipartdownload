{
  "name": "s3-multipartdownload",
  "version": "2.0.0",
  "description": "Fast parallel S3 downloads for Node.js: split large Amazon S3 objects into byte ranges, download them concurrently with AWS SDK v3 and stream to disk with retries, progress and cancellation.",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
